<body>
<div class="reading-nav" style="position:sticky; top:0; z-index:20; background:rgba(251,246,238,.96); border-bottom:1px solid #e7ddcc; backdrop-filter:blur(6px);">
  <div class="wrap" style="max-width:640px; margin:0 auto; padding:12px 22px; display:flex; justify-content:space-between; align-items:center;">
    <a href="index.html" style="color:#2b2420; text-decoration:none; font-weight:700; letter-spacing:.2px;">← Halaman 1</a>
    <span style="font-size:11px; letter-spacing:2px; text-transform:uppercase; color:#6b5f54;">Lanjutan</span>
  </div>
